<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Arms Race Tracker" Width="850" Height="674" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="#EDF0F4" WindowStartupLocation="CenterScreen">
  <Border Background="#14181E" BorderBrush="#343D49" BorderThickness="1" CornerRadius="14">
    <Grid Margin="28,18,28,18">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="134"/><RowDefinition Height="20"/><RowDefinition Height="100"/><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
      <Grid x:Name="DragHeader" Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,0">
          <Border Width="39" Height="39" CornerRadius="8" Background="#F29854" Margin="0,0,12,0"><TextBlock Text="AR" Foreground="#17191D" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
          <StackPanel><TextBlock Text="ARMS RACE" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Dein Spiel. Dein Fortschritt." FontSize="11" Foreground="#8E99A8" Margin="0,3,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="MinimizeButton" Style="{DynamicResource IconButton}" ToolTip="Minimieren" AutomationProperties.Name="Minimieren"><Path Data="M 0,7 L 12,7" Width="12" Height="12" Stroke="#AAB3BF" StrokeThickness="1.5" Stretch="Uniform" IsHitTestVisible="False"/></Button>
          <Button x:Name="CloseButton" Style="{DynamicResource IconButton}" ToolTip="Anzeige schließen. Der Zähler läuft weiter." AutomationProperties.Name="Anzeige schließen"><Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" Stroke="#AAB3BF" StrokeThickness="1.5" Stretch="Uniform" IsHitTestVisible="False"/></Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="#1C232C" CornerRadius="10" BorderBrush="#303A46" BorderThickness="1">
        <Grid Margin="22,14,22,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="GEZÄHLTE ONLINE-SIEGE" Style="{DynamicResource Eyebrow}"/>
            <StackPanel Orientation="Horizontal" Margin="0,-2,0,0"><TextBlock x:Name="WinNumber" Text="—" FontSize="66" FontWeight="SemiBold" Foreground="#F3A465"/><TextBlock Text="seit Trackingstart" VerticalAlignment="Bottom" Margin="14,0,0,17" FontSize="12" Foreground="#9DA7B4"/></StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button x:Name="ShowHudButton" Style="{DynamicResource PrimaryButton}" Content="HUD anzeigen" Width="176"/>
            <TextBlock Text="Strg + Alt + H" FontSize="11" Foreground="#8D98A7" HorizontalAlignment="Center" Margin="0,9,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#1B2028" CornerRadius="9" Padding="16,13"><StackPanel><TextBlock Text="LIVE-STATUS" Style="{DynamicResource Eyebrow}"/><TextBlock x:Name="CurrentMap" Text="Verbinden …" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="CurrentDetail" Text="Lokaler Empfänger" FontSize="11" Foreground="#96A1B0" Margin="0,5,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Background="#1B2028" CornerRadius="9" Padding="16,13"><StackPanel><TextBlock Text="LETZTER SIEG" Style="{DynamicResource Eyebrow}"/><TextBlock x:Name="LastWinMap" Text="Noch kein Sieg" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="LastWinTime" Text="Wird automatisch erfasst" FontSize="11" Foreground="#96A1B0" Margin="0,5,0,0"/></StackPanel></Border>
        <Border Grid.Column="4" Background="#1B2028" CornerRadius="9" Padding="16,13"><StackPanel><TextBlock Text="ÜBUNG AUSGESCHLOSSEN" Style="{DynamicResource Eyebrow}"/><TextBlock x:Name="PracticeNumber" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Bleibt außerhalb der Siegsumme" FontSize="10" Foreground="#96A1B0" Margin="0,3,0,0"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="4" VerticalAlignment="Center"><TextBlock Text="MATCHVERLAUF" Style="{DynamicResource Eyebrow}"/><TextBlock x:Name="HistoryCount" Text="" HorizontalAlignment="Right" Foreground="#8793A2" FontSize="11"/></Grid>
      <Border Grid.Row="5" Background="#181D24" CornerRadius="9" Padding="14,7,14,6">
        <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="76"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
            <TextBlock Text="MAP" Style="{DynamicResource Eyebrow}"/><TextBlock Grid.Column="1" Text="ERGEBNIS" Style="{DynamicResource Eyebrow}"/><TextBlock Grid.Column="2" Text="K / D" Style="{DynamicResource Eyebrow}"/><TextBlock Grid.Column="3" Text="ZEIT" Style="{DynamicResource Eyebrow}" HorizontalAlignment="Right"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HistoryRows"/></ScrollViewer>
        </Grid>
      </Border>
      <Grid Grid.Row="6" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#778394" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="Verbindung wird geprüft" FontSize="10" Foreground="#98A3B2"/></StackPanel>
        <Button x:Name="FolderButton" Style="{DynamicResource IconButton}" Width="98" Height="27" Padding="4" Content="Datenordner" FontSize="10" HorizontalAlignment="Right" ToolTip="Lokale Daten im Explorer öffnen"/>
      </Grid>
    </Grid>
  </Border>
</Window>
