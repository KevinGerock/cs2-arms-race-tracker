<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Arms Race Tracker" Width="920" Height="710" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="#EDF0F4" WindowStartupLocation="CenterScreen">
  <Border Background="#14181E" BorderBrush="#343D49" BorderThickness="1" CornerRadius="14">
    <Grid Margin="28,18,28,18">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="134"/><RowDefinition Height="20"/><RowDefinition Height="100"/><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="30"/><RowDefinition Height="36"/></Grid.RowDefinitions>
      <Grid x:Name="DragHeader" Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,0">
          <Border Width="39" Height="39" CornerRadius="8" Background="#F29854" Margin="0,0,12,0"><TextBlock Text="AR" Foreground="#17191D" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Tag="text:monogram"/></Border>
          <StackPanel><TextBlock Text="Arms Race" FontSize="17" FontWeight="SemiBold" Tag="text:gameName"/><TextBlock Text="Your game. Your progress." FontSize="11" Foreground="#8E99A8" Margin="0,3,0,0" Tag="text:tagline"/></StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <TextBlock Text="Language" Tag="text:language" Foreground="#AAB3BF" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"/>
          <ComboBox x:Name="LanguageSelector" Width="120" Height="30" Margin="0,0,12,0" Tag="automation:language" Style="{DynamicResource LanguageCombo}"/>
          <Button x:Name="MinimizeButton" Style="{DynamicResource IconButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize" Tag="tooltip:minimize;automation:minimize"><Path Data="M 0,7 L 12,7" Width="12" Height="12" Stroke="#AAB3BF" StrokeThickness="1.5" Stretch="Uniform" IsHitTestVisible="False"/></Button>
          <Button x:Name="CloseButton" Style="{DynamicResource IconButton}" ToolTip="Close display. The counter keeps running." AutomationProperties.Name="Close display. The counter keeps running." Tag="tooltip:closeDisplay;automation:closeDisplay"><Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" Stroke="#AAB3BF" StrokeThickness="1.5" Stretch="Uniform" IsHitTestVisible="False"/></Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="#1C232C" CornerRadius="10" BorderBrush="#303A46" BorderThickness="1">
        <Grid Margin="22,14,22,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="TRACKED ONLINE WINS" Style="{DynamicResource Eyebrow}" Tag="text:onlineWinsTitle"/>
            <StackPanel Orientation="Horizontal" Margin="0,-2,0,0"><TextBlock x:Name="WinNumber" Text="—" FontSize="66" FontWeight="SemiBold" Foreground="#F3A465"/><TextBlock Text="since tracking started" VerticalAlignment="Bottom" Margin="14,0,0,17" FontSize="12" Foreground="#9DA7B4" Tag="text:sinceStart"/></StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button x:Name="ShowHudButton" Style="{DynamicResource PrimaryButton}" Content="Show HUD" Width="176" Tag="content:showHud"/>
            <TextBlock Text="Ctrl + Alt + H" FontSize="11" Foreground="#8D98A7" HorizontalAlignment="Center" Margin="0,9,0,0" Tag="text:hudShortcut"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#1B2028" CornerRadius="9" Padding="16,13"><StackPanel><TextBlock Text="LIVE STATUS" Style="{DynamicResource Eyebrow}" Tag="text:liveStatusTitle"/><TextBlock x:Name="CurrentMap" Text="Connecting…" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0" Tag="text:connecting"/><TextBlock x:Name="CurrentDetail" Text="Local receiver" FontSize="11" Foreground="#96A1B0" Margin="0,5,0,0" Tag="text:localReceiver"/></StackPanel></Border>
        <Border Grid.Column="2" Background="#1B2028" CornerRadius="9" Padding="16,13"><StackPanel><TextBlock Text="LAST WIN" Style="{DynamicResource Eyebrow}" Tag="text:lastWinTitle"/><TextBlock x:Name="LastWinMap" Text="No wins yet" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0" Tag="text:noWinYet"/><TextBlock x:Name="LastWinTime" Text="Recorded automatically" FontSize="11" Foreground="#96A1B0" Margin="0,5,0,0" Tag="text:recordedAutomatically"/></StackPanel></Border>
        <Border Grid.Column="4" Background="#1B2028" CornerRadius="9" Padding="16,13"><StackPanel><TextBlock Text="PRACTICE EXCLUDED" Style="{DynamicResource Eyebrow}" Tag="text:practiceTitle"/><TextBlock x:Name="PracticeNumber" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Not included in the win total" FontSize="10" Foreground="#96A1B0" Margin="0,3,0,0" Tag="text:practiceCaption"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="4" VerticalAlignment="Center"><TextBlock Text="MATCH HISTORY" Style="{DynamicResource Eyebrow}" Tag="text:historyTitle"/><TextBlock x:Name="HistoryCount" Text="" HorizontalAlignment="Right" Foreground="#8793A2" FontSize="11"/></Grid>
      <Border Grid.Row="5" Background="#181D24" CornerRadius="9" Padding="14,7,14,6">
        <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="76"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
            <TextBlock Text="MAP" Style="{DynamicResource Eyebrow}" Tag="text:mapColumn"/><TextBlock Grid.Column="1" Text="RESULT" Style="{DynamicResource Eyebrow}" Tag="text:resultColumn"/><TextBlock Grid.Column="2" Text="K / D" Style="{DynamicResource Eyebrow}" Tag="text:kdColumn;tooltip:kdTooltip"/><TextBlock Grid.Column="3" Text="TIME" Style="{DynamicResource Eyebrow}" HorizontalAlignment="Right" Tag="text:timeColumn"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HistoryRows"/></ScrollViewer>
        </Grid>
      </Border>
      <TextBlock Grid.Row="6" Text="HUD visibility: set CS2 to Fullscreen Windowed. Ctrl + Alt + H toggles the HUD." Tag="text:hudHelp" Foreground="#A8B3C1" FontSize="10" VerticalAlignment="Center"/>
      <Grid Grid.Row="7" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#778394" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="Checking connection" FontSize="10" Foreground="#98A3B2" Tag="text:checkingConnection"/></StackPanel>
        <Button x:Name="FolderButton" Style="{DynamicResource IconButton}" Width="98" Height="27" Padding="4" Content="Data folder" FontSize="10" HorizontalAlignment="Right" ToolTip="Open local data in File Explorer" Tag="content:dataFolder;tooltip:dataFolderTooltip"/>
      </Grid>
    </Grid>
  </Border>
</Window>
