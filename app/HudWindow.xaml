<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Arms Race HUD" Width="360" Height="164" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" Foreground="#EFF2F6" ShowActivated="False">
  <Border Background="#F0151B23" CornerRadius="10" BorderThickness="1" BorderBrush="#485361">
    <Grid x:Name="HudDrag" Background="Transparent" Margin="16,11,14,11"><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Rectangle Fill="#F29854" Width="3" Height="12" Margin="0,0,8,0"/><TextBlock Text="Arms Race" FontWeight="SemiBold" FontSize="10" Foreground="#AAB4C1" Tag="text:gameName"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="HudLockButton" Style="{DynamicResource IconButton}" Width="25" Height="24" Padding="5" ToolTip="Lock / unlock HUD (Ctrl + Alt + L)" AutomationProperties.Name="Lock / unlock HUD" Tag="tooltip:lockHudTooltip;automation:lockHud"><Path Data="M 3,6 L 3,3 C 3,0 9,0 9,3 L 9,6 M 1,6 L 11,6 L 11,13 L 1,13 Z" Width="12" Height="13" Stretch="Uniform" Stroke="#AAB4C1" StrokeThickness="1.3" IsHitTestVisible="False"/></Button><Button x:Name="HudExpandButton" Style="{DynamicResource IconButton}" Width="25" Height="24" Padding="5" ToolTip="Open window (Ctrl + Alt + H)" AutomationProperties.Name="Open window" Tag="tooltip:openWindowTooltip;automation:openWindow"><Path Data="M 0,4 L 0,12 L 8,12 M 4,0 L 12,0 L 12,8 M 12,0 L 5,7" Width="12" Height="12" Stretch="Uniform" Stroke="#AAB4C1" StrokeThickness="1.3" IsHitTestVisible="False"/></Button></StackPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="HudWins" Text="—" FontSize="48" FontWeight="SemiBold" Foreground="#F4A260" Margin="0,-8,0,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,-2,0,0"><TextBlock Text="ONLINE WINS" FontSize="10" FontWeight="SemiBold" Foreground="#D6DEE8" Tag="text:onlineWinsShort"/><TextBlock x:Name="HudMap" Text="Waiting for CS2" FontSize="12" Margin="0,4,0,0" Foreground="#A2ADBC" TextTrimming="CharacterEllipsis" Tag="text:waitingForCs2"/></StackPanel>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#37414E" BorderThickness="0,1,0,0" Padding="0,7,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><TextBlock x:Name="HudState" Text="Connecting…" FontSize="9" Foreground="#A3AFBE" Tag="text:connecting" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" x:Name="HudLockState" Text="Movable" FontSize="9" Foreground="#7D8A9C" HorizontalAlignment="Right" Tag="text:movable"/></Grid></Border>
    </Grid>
  </Border>
</Window>
